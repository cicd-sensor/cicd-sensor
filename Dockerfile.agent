# syntax=docker/dockerfile:1.26
#
# cicd-sensor CI agent image (BPF-based observation agent).
#
# Runtime requires CAP_BPF + CAP_PERFMON + cgroup v2 access.

FROM --platform=${BUILDPLATFORM:-linux/amd64} cgr.dev/chainguard/go:latest@sha256:2ff317e00c15628b463b5d37d56a132cf46b7870411e35ff3208260441898803 AS builder
WORKDIR /src

COPY go.mod go.sum ./
COPY vendor ./vendor
COPY cmd ./cmd
COPY internal ./internal

ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG VERSION=dev

ENV CGO_ENABLED=0
RUN --mount=type=cache,target=/root/.cache/go-build \
    GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build \
        -mod=vendor \
        -trimpath \
        -buildvcs=false \
        -ldflags="-s -w -X github.com/cicd-sensor/cicd-sensor/internal/version.Current=${VERSION}" \
        -o /out/cicd-sensor \
        ./cmd/cicd-sensor && \
    GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build \
        -mod=vendor \
        -trimpath \
        -buildvcs=false \
        -ldflags="-s -w -X github.com/cicd-sensor/cicd-sensor/internal/version.Current=${VERSION}" \
        -o /out/cicd-sensorctl \
        ./cmd/cicd-sensorctl

FROM cgr.dev/chainguard/static:latest@sha256:24dd7ff8788fdfadda39eeeaefefb6d1cec6002a545935a5f7e017484053734f
COPY --from=builder /out/cicd-sensor /usr/local/bin/cicd-sensor
COPY --from=builder /out/cicd-sensorctl /usr/local/bin/cicd-sensorctl

ENTRYPOINT ["/usr/local/bin/cicd-sensor"]
