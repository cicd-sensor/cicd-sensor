# syntax=docker/dockerfile:1.27
#
# cicd-sensor CI agent image (BPF-based observation agent).
#
# Runtime requires CAP_BPF + CAP_PERFMON + cgroup v2 access.

FROM --platform=${BUILDPLATFORM:-linux/amd64} cgr.dev/chainguard/go:latest@sha256:c2ace3949b11f2569cb121f370aba004e5e24fd52457b3c31697e6fe3e6a7625 AS builder
WORKDIR /src

COPY go.mod go.sum ./
COPY vendor ./vendor
COPY cmd ./cmd
COPY internal ./internal

ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev

ENV CGO_ENABLED=0
RUN --mount=type=cache,target=/root/.cache/go-build \
    GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build \
        -mod=vendor \
        -trimpath \
        -buildvcs=false \
        -ldflags="-s -w -X github.com/cicd-sensor/cicd-sensor/internal/version.Current=${VERSION}" \
        -o /out/cicd-sensor \
        ./cmd/cicd-sensor && \
    GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build \
        -mod=vendor \
        -trimpath \
        -buildvcs=false \
        -ldflags="-s -w -X github.com/cicd-sensor/cicd-sensor/internal/version.Current=${VERSION}" \
        -o /out/cicd-sensorctl \
        ./cmd/cicd-sensorctl

FROM cgr.dev/chainguard/static:latest@sha256:bf639cba19ba56329e6907ac26a7afcdde57a80b6aa66d5100da6883196e6b82
COPY --from=builder /out/cicd-sensor /usr/local/bin/cicd-sensor
COPY --from=builder /out/cicd-sensorctl /usr/local/bin/cicd-sensorctl

ENTRYPOINT ["/usr/local/bin/cicd-sensor"]
