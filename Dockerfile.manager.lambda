# syntax=docker/dockerfile:1.28
#
# cicd-sensor-manager container image (Lambda adapter).
#

FROM public.ecr.aws/awsguru/aws-lambda-adapter:1.1.0@sha256:17cfd08eff1dfea3f6a9a1e9c65fdac80aa4919b6085e746615530f43f57d2f1 AS lambda-adapter

FROM --platform=${BUILDPLATFORM:-linux/amd64} cgr.dev/chainguard/go:latest@sha256:884f77f46d3521dac40a11359c50188ea376642d76bafa004205f97da006ca0b AS builder
WORKDIR /src

COPY go.mod go.sum ./
COPY vendor ./vendor
COPY cmd ./cmd
COPY internal ./internal

ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev

ENV CGO_ENABLED=0
RUN --mount=type=cache,target=/root/.cache/go-build \
    GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build \
        -mod=vendor \
        -trimpath \
        -buildvcs=false \
        -ldflags="-s -w -X github.com/cicd-sensor/cicd-sensor/internal/version.Current=${VERSION}" \
        -o /out/cicd-sensor-manager \
        ./cmd/cicd-sensor-manager

FROM cgr.dev/chainguard/static:latest@sha256:9e2306b457ff71ce370043dc68c7b52bb1e6622c1c6c6714edbed57496f3116e

# Lambda adapter
COPY --from=lambda-adapter /lambda-adapter /opt/extensions/lambda-adapter

COPY --from=builder /out/cicd-sensor-manager /usr/local/bin/cicd-sensor-manager

# Default config and rules paths can be overridden by setting the env vars
# or by passing --config-file / --rules-file flags. Set CICD_SENSOR_MANAGER_RULES_FILE
# to enable customer rules (no default since the file is optional).
ENV CICD_SENSOR_MANAGER_CONFIG_FILE=/etc/cicd-sensor/manager.yaml

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/cicd-sensor-manager"]
